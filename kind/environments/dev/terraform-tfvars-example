cluster_name        = "dev-cluster"
node_image          = "kindest/node:v1.30.0"
disable_default_cni = false
pod_subnet          = "10.244.0.0/16"
ingress_http_port   = 9080
ingress_https_port  = 9443

port_mappings = [
  { host_port = 9081, container_port = 30081, protocol = "TCP" },
  { host_port = 9082, container_port = 30082, protocol = "TCP" },
  { host_port = 9083, container_port = 30083, protocol = "TCP" },
  { host_port = 9084, container_port = 30084, protocol = "TCP" },
  { host_port = 9085, container_port = 30085, protocol = "TCP" }
]